{
  "name": "pi-office",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Anaz Haidhar (https://anazhd.com)",
  "engines": {
    "node": ">=24.12.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "node server/index.ts",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs doctor",
    "dev": "expo start --web",
    "build": "node scripts/build.mjs",
    "build:mock": "node scripts/build.mjs --mock",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:server": "node --test server/tests/*.test.ts",
    "test:scene": "node --test src/scene/tests/*.test.ts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check": "npm run typecheck && npm run test:server && npm run test:scene && npm run test:scripts && npm run build"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "nativewind": "5.0.0-rc.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "react-native-css": "3.1.0-rc.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "lightningcss": "1.30.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "agent-browser": "^0.39.1",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "^8.5.30"
  }
}
