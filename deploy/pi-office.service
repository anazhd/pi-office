[Unit]
Description=pi-office (isolated service)
After=network.target

[Service]
User=pi-office
Group=pi-office
SupplementaryGroups=pi-data-readers
WorkingDirectory=/srv/pi-office
ExecStart=/usr/local/lib/pi-node/node /srv/pi-office/server/index.ts
Environment=HOME=/nonexistent
Environment=HOST=127.0.0.1
Environment=PORT=6702
Environment=PI_CODING_AGENT_DIR=/var/lib/pi-data
Environment=PI_OFFICE_SESSIONS_DIR=/var/lib/pi-data/sessions
Environment=PI_OFFICE_STATE_FILE=/var/lib/pi-office/desks.json
Environment=PI_OFFICE_ALLOWED_HOSTS=office.anazhd.com
Environment=PI_OFFICE_CLIENT_IP_HEADER=cf-connecting-ip
Environment=PI_OFFICE_TRUSTED_PROXIES=127.0.0.1,::1
StateDirectory=pi-office
StateDirectoryMode=0700
BindReadOnlyPaths=-/root/.pi/agent/settings.json:/var/lib/pi-data/settings.json
BindReadOnlyPaths=-/root/.pi/agent/models-store.json:/var/lib/pi-data/models-store.json
BindReadOnlyPaths=-/root/.pi/agent/models.json:/var/lib/pi-data/models.json
BindReadOnlyPaths=/root/github/pi-office:/srv/pi-office
BindReadOnlyPaths=/root/.pi/agent/sessions:/var/lib/pi-data/sessions
ProtectHome=tmpfs
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
